<mujoco model="teaching_ball_contact">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler" iterations="50"/>
  <default>
    <geom friction="0.8 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </default>
  <worldbody>
    <geom name="ground" type="plane" size="1 1 0.1" rgba="0.7 0.7 0.7 1"/>
    <body name="ball" pos="0 0 0.3">
      <freejoint name="root"/>
      <geom name="ball_geom" type="sphere" size="0.05" mass="1" rgba="0.2 0.4 0.8 1"/>
    </body>
  </worldbody>
</mujoco>
